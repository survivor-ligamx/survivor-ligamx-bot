# Survivor Liga MX Bot — Plantilla de configuración
# Copia a .env. Nunca guardes claves reales en Git.

# API web / persistencia
API_KEY=cambia-esto-por-una-clave-fuerte-y-secreta
DATABASE_URL=
API_BASE=https://survivor-ligamx-bot.onrender.com
SURVIVOR_TEMPORADA=Apertura-2026

# Momios opcionales
ODDS_API_IO_KEY=
ODDS_API_IO_LIGA=mexico-liga-mx-apertura
ODDS_API_IO_MAX_CASAS=2

# Liga MX API
LIGAMX_API_URL=https://ligamx-api.onrender.com
LIGAMX_API_TIMEOUT=30
LIGAMX_API_AS_SOURCE=
LIGAMX_API_SYNC_KEY=

# IA opcional; resume noticias reales, nunca cambia el pick por sí sola
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=

# Contexto web de disponibilidad por equipo
# Se actualiza fuera de /pick y se consume desde caché.
WEB_CONTEXT_ENABLED=1
# Ventana previa configurable; default 5 y el código la acota entre 1 y 10.
WEB_CONTEXT_PREMATCH_DAYS=5
# Máximo de partidos consultados por ciclo y búsquedas externas por día.
WEB_CONTEXT_MATCH_LIMIT=9
WEB_CONTEXT_MAX_DAILY=30
# Proveedores escalonados: Tavily -> GNews -> Serper. Al menos uno.
TAVILY_API_KEY=
GNEWS_API_KEY=
SERPER_API_KEY=
# El scheduler usa seis horas por defecto.
WEB_CONTEXT_INTERVAL_HOURS=6

# Telegram informativo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_CONFIGURE=true
